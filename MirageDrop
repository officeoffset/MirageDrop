<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#120b25">
<title>MIRAGE DROP - 幻影の雫</title>
<style>
:root{color-scheme:dark}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#090714;font-family:system-ui,sans-serif;touch-action:none}
#wrap{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(ellipse at 50% 25%,#291447,#090714 70%);padding:8px}
#top{width:min(100%,960px);display:flex;justify-content:space-between;gap:8px;align-items:center;color:#f7eaff;font-size:12px;padding:4px 2px}
#game{width:min(100%,960px);max-height:calc(100dvh - 140px);aspect-ratio:16/9;display:block;border:2px solid #d35cff;border-radius:8px;box-shadow:0 0 22px #b13dff55;background:#130c29;image-rendering:pixelated}
#controls{width:min(100%,960px);display:flex;justify-content:space-between;align-items:center;gap:10px;padding-top:10px;user-select:none}
.group{display:flex;gap:8px;align-items:center}
.ctrl{border:2px solid #b96bff;background:#281441;color:white;border-radius:14px;min-width:54px;height:54px;font-size:20px;font-weight:800;box-shadow:0 3px 0 #6b328e;touch-action:none}
.ctrl:active,.ctrl.on{background:#8b39bc;transform:translateY(2px);box-shadow:0 1px 0 #6b328e}
.ctrl.small{font-size:12px;min-width:48px}.hint{color:#c7b4dd;font-size:11px;text-align:center;padding-top:5px}
@media (min-width:700px){.ctrl{min-width:64px;height:58px}.ctrl.small{min-width:58px}}
</style>
</head>
<body>
<div id="wrap">
  <div id="top"><b>✦ MIRAGE DROP ✦</b><span id="status">ハクアとノアの冒険</span><button class="ctrl small" id="pause">一時停止</button></div>
  <canvas id="game" width="480" height="270" aria-label="MIRAGE DROP game"></canvas>
  <div id="controls">
    <div class="group"><button class="ctrl" data-key="left">◀</button><button class="ctrl" data-key="right">▶</button></div>
    <div class="group"><button class="ctrl" data-key="jump">跳</button><button class="ctrl" data-key="slash">剣</button><button class="ctrl" data-key="magic">魔</button></div>
  </div>
  <div class="hint">移動：◀ ▶　ジャンプ：跳　剣攻撃：剣　魔法：魔　｜　PC：矢印 / Space / Z / X</div>
</div>
<script>
(()=>{
const c=document.getElementById('game'),ctx=c.getContext('2d'),status=document.getElementById('status');
ctx.imageSmoothingEnabled=false;
const W=480,H=270, floor=222, keys={left:false,right:false,jump:false,slash:false,magic:false};
let state='title',paused=false,frame=0,score=0,magicCooldown=0,slashTimer=0,particles=[];
const player={x:54,y:floor-34,w:19,h:34,vx:0,vy:0,hp:5,face:1,onGround:true,inv:0};
let enemies=[],shots=[];
function reset(){player.x=54;player.y=floor-player.h;player.vx=0;player.vy=0;player.hp=5;player.face=1;player.inv=0;score=0;frame=0;magicCooldown=0;slashTimer=0;particles=[];shots=[];enemies=[{x:220,y:floor-23,w:22,h:23,hp:2,dir:-1},{x:350,y:floor-23,w:22,h:23,hp:2,dir:1},{x:430,y:floor-30,w:30,h:30,hp:5,dir:-1,boss:true}];state='play';status.textContent='HP ♥♥♥♥♥　敵を倒してゴールへ'}
function rect(x,y,w,h,color){ctx.fillStyle=color;ctx.fillRect(Math.round(x),Math.round(y),w,h)}
function text(t,x,y,size=10,color='#fff'){ctx.fillStyle=color;ctx.font=`bold ${size}px monospace`;ctx.fillText(t,x,y)}
function burst(x,y,color,n=8){for(let i=0;i<n;i++)particles.push({x,y,vx:(Math.random()-.5)*3,vy:(Math.random()-.7)*3,life:18+Math.random()*12,color})}
function background(){
 const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#100923');g.addColorStop(1,'#31134d');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
 ctx.fillStyle='#ff9df2';ctx.globalAlpha=.7;ctx.beginPath();ctx.arc(386,52,22,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
 for(let i=0;i<18;i++){let x=i*30-((frame*.12)%30),h=35+(i*17%65);rect(x,floor-h,23,h,'#201038');rect(x+5,floor-h+8,3,4,'#a744dc');rect(x+14,floor-h+19,3,4,'#e65ecb')}
 rect(0,floor,W,3,'#fa71ff');rect(0,floor+3,W,H-floor-3,'#170d2a');
 for(let x=-20;x<W+30;x+=30){rect(x,floor+12,1,35,'#52246e');rect(x,floor+44,22,1,'#52246e')}
 for(let i=0;i<5;i++){let x=(i*113-frame*.45)%(W+40);rect(x,floor-3,18,2,'#ff83ed')}
}
function drawHero(){
 const x=player.x,y=player.y;if(player.inv>0&&Math.floor(frame/3)%2===0)return;
 rect(x-3,floor-2,25,3,'#090714');
 rect(x+4,y+1,12,11,'#d9d9ef');rect(x+2,y+5,4,16,'#bcb8e6');rect(x+14,y+8,5,12,'#a49bd8');
 rect(x+7,y+6,9,9,'#ffe0ef');rect(x+12,y+9,2,2,'#ff54c8');
 rect(x+5,y+15,12,10,'#24112f');rect(x+2,y+22,18,6,'#6c2b91');rect(x+4,y+25,5,4,'#e2baff');rect(x+13,y+25,5,4,'#e2baff');
 rect(x+5,y+29,5,5,'#130d22');rect(x+14,y+29,5,5,'#130d22');rect(x+(player.face>0?1:17),y+15,4,13,'#a93ad7');
 if(slashTimer>0){ctx.save();ctx.translate(x+10,y+17);ctx.rotate(player.face*.75);rect(0,-3,25,3,'#fff0ff');rect(3,-5,9,2,'#ff71e7');ctx.restore();ctx.strokeStyle='#ffb6ff';ctx.globalAlpha=.7;ctx.beginPath();ctx.arc(x+10,y+18,24,-.9,1.1);ctx.stroke();ctx.globalAlpha=1}
 const nx=x-10,ny=y-8+Math.sin(frame*.12)*3;ctx.fillStyle='#e9d7ff';ctx.beginPath();ctx.arc(nx,ny,6,0,Math.PI*2);ctx.fill();rect(nx-4,ny-2,2,2,'#8f49e8');rect(nx+2,ny-2,2,2,'#8f49e8');rect(nx-2,ny+2,4,1,'#ff83df');rect(nx-7,ny-1,2,3,'#b6faff');rect(nx+5,ny-1,2,3,'#b6faff');
}
function drawEnemy(e){const x=e.x,y=e.y;rect(x-2,floor-2,e.w+4,2,'#080512');rect(x,y+5,e.w,e.h-5,e.boss?'#651c8c':'#49235f');rect(x+3,y,e.w-6,8,e.boss?'#db42ff':'#a13ce0');rect(x+4,y+9,4,4,'#ff6bdc');rect(x+e.w-8,y+9,4,4,'#ff6bdc');rect(x+4,y+e.h-4,5,4,'#170b25');rect(x+e.w-9,y+e.h-4,5,4,'#170b25');if(e.boss){text('BOSS',x-2,y-5,8,'#ffb5fa');for(let i=0;i<e.hp;i++)rect(x+i*5,y-10,4,2,'#ff6bdc')}}
function draw(){
 background();
 for(let i=0;i<25;i++){let x=(i*71+frame*.25)%(W),y=(i*37)%150;rect(x,y,1,1,'#dba9ff')}
 rect(458,floor-52,4,52,'#ff79f2');rect(450,floor-45,2,45,'#9e56ff');rect(466,floor-45,2,45,'#9e56ff');
 enemies.forEach(drawEnemy);shots.forEach(s=>{ctx.fillStyle='#d99aff';ctx.beginPath();ctx.arc(s.x,s.y,4,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#ffb9f8';ctx.stroke()});drawHero();
 particles.forEach(p=>rect(p.x,p.y,2,2,p.color));
 rect(8,8,104,26,'#140b25');text('HP',14,19,9,'#ffb9f5');for(let i=0;i<5;i++)text(i<player.hp?'♥':'♡',36+i*13,20,11,i<player.hp?'#ff5ccf':'#70537d');text('SCORE '+score,14,29,8,'#e8d3ff');
 if(state==='title'||state==='win'||state==='over'||paused){rect(58,65,364,116,'#100820');rect(58,65,364,2,'#e56cff');rect(58,179,364,2,'#e56cff');
 if(state==='title'){text('MIRAGE DROP',126,94,22,'#ff9bea');text('幻影の雫',190,113,11,'#e7c8ff');text('ハクアとノアのネオンアクション',112,135,10,'#fff');text('画面をタップ / 剣ボタンでスタート',103,157,10,'#ffb5f7')}
 if(state==='win'){text('STAGE CLEAR!',158,106,20,'#ff9bea');text('SCORE '+score,205,130,12);text('画面をタップしてもう一度',157,155,10,'#e7c8ff')}
 if(state==='over'){text('GAME OVER',169,108,20,'#ff7bdc');text('SCORE '+score,205,131,12);text('画面をタップして再挑戦',165,155,10,'#e7c8ff')}
 if(paused&&state==='play')text('PAUSED',204,127,18,'#ff9bea')}
}
function hit(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y}
function attack(){slashTimer=10;let box={x:player.face>0?player.x+player.w:player.x-24,y:player.y+5,w:24,h:25};let hitAny=false;enemies.forEach(e=>{if(e.hp>0&&hit(box,e)){e.hp--;hitAny=true;burst(e.x+e.w/2,e.y+8,'#ff83ed',6);if(e.hp<=0){score+=e.boss?100:25;burst(e.x,e.y,'#d15cff',14)}}});if(hitAny){}}
function magic(){if(magicCooldown>0)return;magicCooldown=38;shots.push({x:player.x+(player.face>0?player.w:0),y:player.y+15,vx:player.face*5});burst(player.x+10,player.y+15,'#ba73ff',5)}
function step(){
 if(state!=='play'||paused)return;
 frame++;if(player.inv>0)player.inv--;if(slashTimer>0)slashTimer--;if(magicCooldown>0)magicCooldown--;
 player.vx=(keys.left?-2.3:0)+(keys.right?2.3:0);if(player.vx)player.face=Math.sign(player.vx);
 player.x=Math.max(3,Math.min(W-player.w-4,player.x+player.vx));
 if(keys.jump&&player.onGround){player.vy=-7.3;player.onGround=false}
 player.vy+=.34;player.y+=player.vy;if(player.y+player.h>=floor){player.y=floor-player.h;player.vy=0;player.onGround=true}
 if(keys.slash&&slashTimer<=0)attack();if(keys.magic)magic();
 enemies.forEach(e=>{if(e.hp<=0)return;let d=player.x-e.x;if(Math.abs(d)<130)e.dir=d>0?1:-1;e.x+=e.dir*(e.boss?.45:.65);e.x=Math.max(125,Math.min(445-e.w,e.x));if(hit(player,e)&&player.inv<=0){player.hp--;player.inv=55;player.vy=-3;if(player.hp<=0){state='over';status.textContent='ゲームオーバー'}}});
 shots=shots.filter(s=>s.x>-10&&s.x<W+10);shots.forEach(s=>{s.x+=s.vx;enemies.forEach(e=>{if(e.hp>0&&hit({x:s.x-4,y:s.y-4,w:8,h:8},e)){e.hp--;s.x=W+100;burst(e.x,e.y,'#c48cff',8);if(e.hp<=0)score+=e.boss?100:25}})});
 particles=particles.filter(p=>p.life-->0);particles.forEach(p=>{p.x+=p.vx;p.y+=p.vy;p.vy+=.04});
 if(player.x>443&&enemies.every(e=>e.hp<=0)){state='win';status.textContent='ステージクリア！'}
 status.textContent=`HP ${player.hp}/5　SCORE ${score}　魔法 ${magicCooldown?'充填中':'使用可能'}`;
}
function loop(){step();draw();requestAnimationFrame(loop)}
function startOrRestart(){if(state==='title'||state==='over'||state==='win')reset()}
c.addEventListener('pointerdown',()=>{if(state!=='play')startOrRestart()});
document.querySelectorAll('[data-key]').forEach(b=>{const k=b.dataset.key;const down=e=>{e.preventDefault();if(state!=='play')startOrRestart();keys[k]=true;b.classList.add('on');if(k==='slash'&&state==='play'&&slashTimer<=0)attack();if(k==='magic'&&state==='play')magic()};const up=e=>{e.preventDefault();keys[k]=false;b.classList.remove('on')};b.addEventListener('pointerdown',down);b.addEventListener('pointerup',up);b.addEventListener('pointercancel',up);b.addEventListener('pointerleave',up)});
document.getElementById('pause').addEventListener('click',()=>{if(state==='play'){paused=!paused;document.getElementById('pause').textContent=paused?'再開':'一時停止'}});
window.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','ArrowUp',' ','z','x','Z','X'].includes(e.key))e.preventDefault();if(e.key==='ArrowLeft')keys.left=true;if(e.key==='ArrowRight')keys.right=true;if(e.key==='ArrowUp'||e.key===' ')keys.jump=true;if(e.key.toLowerCase()==='z')keys.slash=true;if(e.key.toLowerCase()==='x')keys.magic=true;if(state!=='play'&&e.key==='Enter')startOrRestart()});
window.addEventListener('keyup',e=>{if(e.key==='ArrowLeft')keys.left=false;if(e.key==='ArrowRight')keys.right=false;if(e.key==='ArrowUp'||e.key===' ')keys.jump=false;if(e.key.toLowerCase()==='z')keys.slash=false;if(e.key.toLowerCase()==='x')keys.magic=false});
state='title';status.textContent='タップして冒険を開始';loop();
})();
</script>
</body>
</html>
