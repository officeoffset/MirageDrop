<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
  <meta name="theme-color" content="#130a22">
  <title>MIRAGE DROP</title>
  <style>
    :root {
      --bg0: #090714;
      --bg1: #150b25;
      --violet: #d55dff;
      --pink: #ff8cd3;
      --blue: #78dcff;
      --deep: #100713;
      --ui: #1a0b2d;
      --ui2: #352154;
      --panel: rgba(25, 13, 40, 0.85);
      --text: #f7ecff;
      --soft: #d8c7ef;
      --danger: #ff5a9f;
      --gold: #ffe48c;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      background: radial-gradient(circle at 50% 15%, #2a143d 0%, #0a0717 54%, #05050c 100%);
      color: var(--text);
      font-family: "Segoe UI", "Noto Sans JP", sans-serif;
      touch-action: none;
      user-select: none;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #wrap {
      width: min(100vw, 1100px);
      height: min(100dvh, 760px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 8px;
    }

    #hudBar {
      width: min(100%, 960px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 2px 4px 0;
      color: #f7eaff;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-shadow: 0 0 12px rgba(220, 106, 255, 0.8);
    }

    #brand {
      font-size: clamp(12px, 2vw, 17px);
      white-space: nowrap;
    }

    #status {
      font-size: clamp(10px, 1.5vw, 13px);
      opacity: 0.9;
    }

    #pauseBtn {
      border: 2px solid #c27dff;
      background: rgba(32, 14, 50, 0.8);
      color: white;
      border-radius: 10px;
      font-size: 12px;
      padding: 7px 12px;
      box-shadow: 0 0 12px rgba(209, 119, 255, 0.3);
      cursor: pointer;
    }

    #game {
      width: min(100%, 960px);
      aspect-ratio: 16 / 9;
      display: block;
      background: linear-gradient(180deg, #11091d 0%, #1a0f2d 60%, #090714 100%);
      border: 2px solid rgba(199, 112, 255, 0.95);
      border-radius: 10px;
      box-shadow: 0 0 32px rgba(176, 84, 255, 0.4), inset 0 0 18px rgba(138, 89, 255, 0.2);
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    #controls {
      width: min(100%, 960px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 2px 2px 0;
      user-select: none;
    }

    .group {
      display: flex;
      gap: 10px;
      align-items: center;
      justify-content: center;
    }

    .ctrl {
      width: min(18vw, 68px);
      height: min(18vw, 62px);
      border-radius: 14px;
      border: 2px solid #b86ff7;
      background: linear-gradient(180deg, rgba(41, 17, 58, 0.9), rgba(24, 12, 41, 0.9));
      color: white;
      font-size: clamp(18px, 3vw, 28px);
      font-weight: 800;
      cursor: pointer;
      touch-action: none;
      box-shadow: 0 4px 0 rgba(116, 59, 158, 0.9), inset 0 0 12px rgba(188, 109, 255, 0.25);
      transition: transform 0.08s ease, filter 0.08s ease;
    }

    .ctrl:active,
    .ctrl.active {
      transform: translateY(2px);
      box-shadow: 0 2px 0 rgba(116, 59, 158, 0.9), inset 0 0 12px rgba(188, 109, 255, 0.25);
      filter: brightness(1.14);
    }

    .ctrl[data-key="jump"] { font-size: clamp(16px, 2.5vw, 24px); }
    .ctrl[data-key="slash"] { font-size: clamp(16px, 2.5vw, 24px); }
    .ctrl[data-key="magic"] { font-size: clamp(16px, 2.5vw, 24px); }

    .hint {
      width: min(100%, 960px);
      text-align: center;
      color: #d9c5ef;
      font-size: 11px;
      opacity: 0.9;
      letter-spacing: 0.04em;
    }

    @media (max-width: 520px) {
      #wrap {
        padding: 6px;
        gap: 6px;
      }

      #hudBar {
        padding: 0 2px;
      }

      #pauseBtn {
        padding: 6px 8px;
      }

      .ctrl {
        width: 54px;
        height: 54px;
      }
    }
  </style>
</head>
<body>
  <div id="wrap">
    <div id="hudBar">
      <div id="brand">✦ MIRAGE DROP ✦</div>
      <div id="status">メニュー</div>
      <button id="pauseBtn" aria-label="Pause">一時停止</button>
    </div>

    <canvas id="game" width="960" height="540" aria-label="MIRAGE DROP game canvas"></canvas>

    <div id="controls">
      <div class="group">
        <button class="ctrl" data-key="left" aria-label="Move left">◀</button>
        <button class="ctrl" data-key="right" aria-label="Move right">▶</button>
      </div>
      <div class="group">
        <button class="ctrl" data-key="jump" aria-label="Jump">跳</button>
        <button class="ctrl" data-key="slash" aria-label="Sword attack">剣</button>
        <button class="ctrl" data-key="magic" aria-label="Magic attack">魔</button>
      </div>
    </div>

    <div class="hint">移動: ◀ ▶ / A D　ジャンプ: ↑ / Space　剣: J / Z　魔法: K / X</div>
  </div>

  <script>
    (() => {
      const canvas = document.getElementById('game');
      const ctx = canvas.getContext('2d');
      const statusEl = document.getElementById('status');
      const pauseBtn = document.getElementById('pauseBtn');

      ctx.imageSmoothingEnabled = false;

      const WORLD = {
        width: 2200,
        height: 540,
        groundY: 390,
        goalX: 2060,
      };

      const input = {
        left: false,
        right: false,
        jump: false,
        attack: false,
        magic: false,
      };

      const state = {
        mode: 'title',
        paused: false,
        time: 0,
        score: 0,
      };

      const camera = { x: 0 };
      const particles = [];
      const projectiles = [];
      const pickups = [];
      let enemies = [];
      let stars = [];
      let floorTiles = [];
      let lastTime = 0;

      const player = {
        x: 80,
        y: WORLD.groundY - 72,
        w: 32,
        h: 72,
        vx: 0,
        vy: 0,
        speed: 235,
        jumpForce: 560,
        onGround: false,
        facing: 1,
        hp: 5,
        maxHp: 5,
        invuln: 0,
        attackTimer: 0,
        attackCooldown: 0,
        magicCooldown: 0,
        isDead: false,
      };

      function clamp(value, min, max) {
        return Math.min(Math.max(value, min), max);
      }

      function rect(x, y, w, h, color) {
        ctx.fillStyle = color;
        ctx.fillRect(Math.round(x), Math.round(y), w, h);
      }

      function circle(x, y, r, color) {
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fill();
      }

      function triangle(x, y, size, color, dir = 1) {
        ctx.fillStyle = color;
        ctx.beginPath();
        if (dir > 0) {
          ctx.moveTo(x, y);
          ctx.lineTo(x + size, y + size * 0.5);
          ctx.lineTo(x, y + size);
        } else {
          ctx.moveTo(x, y);
          ctx.lineTo(x - size, y + size * 0.5);
          ctx.lineTo(x, y + size);
        }
        ctx.closePath();
        ctx.fill();
      }

      function addParticles(x, y, color, count = 12, spread = 3.5) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x,
            y,
            vx: (Math.random() - 0.5) * spread * 4,
            vy: (Math.random() - 0.5) * spread * 4,
            life: 18 + Math.random() * 18,
            size: 2 + Math.random() * 3,
            color,
          });
        }
      }

      function makeStars() {
        stars = [];
        for (let i = 0; i < 120; i++) {
          stars.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height * 0.7,
            r: Math.random() * 2 + 0.5,
            alpha: Math.random() * 0.8 + 0.2,
            speed: 0.4 + Math.random() * 0.7,
          });
        }
      }

      function buildStage() {
        floorTiles = [];
        for (let x = 0; x < WORLD.width; x += 26) {
          floorTiles.push({ x, y: WORLD.groundY + 10, w: 26, h: 140 });
        }

        pickups.length = 0;
        pickups.push({ x: 620, y: 310, w: 18, h: 18, heal: true });
        pickups.push({ x: 1320, y: 240, w: 18, h: 18, heal: true });

        enemies = [
          { x: 470, y: WORLD.groundY - 38, w: 30, h: 38, type: 'goblin', hp: 2, maxHp: 2, vx: 0, dir: 1, speed: 90, alive: true },
          { x: 850, y: WORLD.groundY - 40, w: 30, h: 40, type: 'goblin', hp: 2, maxHp: 2, vx: 0, dir: -1, speed: 95, alive: true },
          { x: 1160, y: WORLD.groundY - 44, w: 32, h: 44, type: 'knight', hp: 3, maxHp: 3, vx: 0, dir: -1, speed: 105, alive: true },
          { x: 1700, y: WORLD.groundY - 46, w: 34, h: 46, type: 'knight', hp: 3, maxHp: 3, vx: 0, dir: 1, speed: 115, alive: true },
          { x: 1942, y: WORLD.groundY - 74, w: 52, h: 74, type: 'boss', hp: 8, maxHp: 8, vx: 0, dir: -1, speed: 110, alive: true },
        ];
      }

      function resetGame() {
        player.x = 80;
        player.y = WORLD.groundY - 72;
        player.vx = 0;
        player.vy = 0;
        player.hp = 5;
        player.maxHp = 5;
        player.invuln = 0;
        player.attackTimer = 0;
        player.attackCooldown = 0;
        player.magicCooldown = 0;
        player.isDead = false;
        player.onGround = false;
        state.score = 0;
        state.time = 0;
        projectiles.length = 0;
        particles.length = 0;
        camera.x = 0;
        buildStage();
        statusEl.textContent = 'ステージ1：月影のネオン街';
      }

      function startGame() {
        state.mode = 'play';
        state.paused = false;
        pauseBtn.textContent = '一時停止';
        resetGame();
      }

      function setPaused(nextMode) {
        if (state.mode !== 'play') return;
        state.paused = nextMode;
        pauseBtn.textContent = nextMode ? '再開' : '一時停止';
      }

      function setState(mode) {
        state.mode = mode;
        if (mode === 'title') {
          statusEl.textContent = 'メニュー';
        }
        if (mode === 'win') {
          statusEl.textContent = 'ステージクリア';
        }
        if (mode === 'over') {
          statusEl.textContent = 'ゲームオーバー';
        }
      }

      function isTouching(a, b) {
        return !(a.x + a.w < b.x || a.x > b.x + b.w || a.y + a.h < b.y || a.y > b.y + b.h);
      }

      function damagePlayer(amount, sourceX) {
        if (player.invuln > 0 || state.mode !== 'play') return;
        player.hp = Math.max(0, player.hp - amount);
        player.invuln = 1.2;
        player.vx = (player.x < sourceX ? -180 : 180);
        player.vy = -170;
        addParticles(player.x + player.w / 2, player.y + player.h / 2, '#ff76b8', 18, 4.6);
        if (player.hp <= 0) {
          state.mode = 'over';
          setState('over');
        }
      }

      function slashAttack() {
        if (player.attackCooldown > 0 || state.mode !== 'play') return;
        player.attackTimer = 0.18;
        player.attackCooldown = 0.36;
        const hitbox = {
          x: player.facing > 0 ? player.x + player.w - 2 : player.x - 44,
          y: player.y + 16,
          w: 46,
          h: 26,
        };

        for (const enemy of enemies) {
          if (!enemy.alive) continue;
          if (isTouching(hitbox, enemy)) {
            enemy.hp -= 1;
            addParticles(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#ffc2fa', 12, 4.8);
            if (enemy.hp <= 0) {
              enemy.alive = false;
              state.score += enemy.type === 'boss' ? 150 : 50;
              addParticles(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#f7d1ff', 22, 5.4);
            }
          }
        }
      }

      function createMagicShot() {
        if (player.magicCooldown > 0 || state.mode !== 'play') return;
        player.magicCooldown = 0.75;
        const shot = {
          x: player.x + player.w / 2 + player.facing * 18,
          y: player.y + 26,
          r: 8,
          vx: player.facing * 430,
          vy: 0,
          life: 1.5,
          color: '#bff4ff',
          damage: 1,
        };
        projectiles.push(shot);
        addParticles(shot.x, shot.y, '#d7d0ff', 8, 3.4);
      }

      function updateParticles(dt) {
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx * dt * 60;
          p.y += p.vy * dt * 60;
          p.vy += 0.12;
          p.life -= dt * 60;
          if (p.life <= 0) particles.splice(i, 1);
        }
      }

      function updateProjectiles(dt) {
        for (let i = projectiles.length - 1; i >= 0; i--) {
          const shot = projectiles[i];
          shot.x += shot.vx * dt;
          shot.y += shot.vy * dt;
          shot.life -= dt;

          let hit = false;
          for (const enemy of enemies) {
            if (!enemy.alive) continue;
            const dx = shot.x - (enemy.x + enemy.w / 2);
            const dy = shot.y - (enemy.y + enemy.h / 2);
            if (Math.abs(dx) < enemy.w / 2 + shot.r && Math.abs(dy) < enemy.h / 2 + shot.r) {
              enemy.hp -= shot.damage;
              addParticles(shot.x, shot.y, '#cbebff', 14, 4.5);
              hit = true;
              if (enemy.hp <= 0) {
                enemy.alive = false;
                state.score += enemy.type === 'boss' ? 150 : 50;
                addParticles(enemy.x + enemy.w / 2, enemy.y + enemy.h / 2, '#e0c7ff', 18, 5);
              }
              break;
            }
          }

          if (shot.life <= 0 || shot.x < -100 || shot.x > WORLD.width + 100 || hit) {
            projectiles.splice(i, 1);
          }
        }
      }

      function updateEnemies(dt) {
        for (const enemy of enemies) {
          if (!enemy.alive) continue;
          const dirToPlayer = player.x + player.w / 2 > enemy.x + enemy.w / 2 ? 1 : -1;
          enemy.dir = dirToPlayer;

          if (Math.abs(player.x - enemy.x) < 200) {
            enemy.vx = enemy.speed * enemy.dir;
          } else {
            enemy.vx = 0;
          }

          enemy.x += enemy.vx * dt;

          const groundY = WORLD.groundY - enemy.h;
          enemy.y = groundY;

          if (isTouching(player, enemy)) {
            damagePlayer(1, enemy.x + enemy.w / 2);
          }
        }
      }

      function updatePickups(dt) {
        for (const pickup of pickups) {
          pickup.y += Math.sin((state.time + pickup.x) * 0.06) * 0.15;
          if (isTouching(player, pickup)) {
            player.hp = Math.min(player.maxHp, player.hp + 1);
            pickup.heal = false;
          }
        }
        for (let i = pickups.length - 1; i >= 0; i--) {
          if (!pickups[i].heal) pickups.splice(i, 1);
        }
      }

      function updatePlayer(dt) {
        const move = (input.left ? -1 : 0) + (input.right ? 1 : 0);
        const targetVx = move * player.speed;
        player.vx += (targetVx - player.vx) * 0.18;

        if (move !== 0) {
          player.facing = move;
        }

        if (input.jump && player.onGround) {
          player.vy = -player.jumpForce;
          player.onGround = false;
          addParticles(player.x + player.w / 2, player.y + player.h, '#ffb5f5', 10, 4.2);
        }

        player.vy += 880 * dt;
        player.x += player.vx * dt;
        player.y += player.vy * dt;

        if (player.x < 0) player.x = 0;
        if (player.x + player.w > WORLD.width) player.x = WORLD.width - player.w;

        const floorY = WORLD.groundY - player.h;
        if (player.y >= floorY) {
          player.y = floorY;
          player.vy = 0;
          player.onGround = true;
        } else {
          player.onGround = false;
        }

        player.attackCooldown = Math.max(0, player.attackCooldown - dt);
        player.magicCooldown = Math.max(0, player.magicCooldown - dt);
        player.invuln = Math.max(0, player.invuln - dt);
        player.attackTimer = Math.max(0, player.attackTimer - dt);

        if (input.attack) {
          slashAttack();
          input.attack = false;
        }

        if (input.magic) {
          createMagicShot();
          input.magic = false;
        }
      }

      function updateCamera() {
        const target = player.x - canvas.width * 0.35;
        camera.x = clamp(target, 0, WORLD.width - canvas.width);
      }

      function update(dt) {
        if (state.mode !== 'play' || state.paused) return;
        state.time += dt;

        updatePlayer(dt);
        updateEnemies(dt);
        updateProjectiles(dt);
        updateParticles(dt);
        updatePickups(dt);
        updateCamera();

        if (player.hp <= 0 && state.mode === 'play') {
          setState('over');
        }

        if (player.x + player.w >= WORLD.goalX) {
          state.score += 200;
          setState('win');
        }

        statusEl.textContent = 'HP ' + player.hp + '/' + player.maxHp + '  SCORE ' + state.score + '  目標: ゴール';
      }

      function drawBackground() {
        const sky = ctx.createLinearGradient(0, 0, 0, canvas.height);
        sky.addColorStop(0, '#120a1f');
        sky.addColorStop(0.45, '#251139');
        sky.addColorStop(1, '#090714');
        ctx.fillStyle = sky;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        for (const star of stars) {
          const x = (star.x - camera.x * 0.15) % (canvas.width + 30);
          ctx.fillStyle = `rgba(255,255,255,${star.alpha})`;
          ctx.fillRect(x, star.y, star.r + 0.5, star.r + 0.5);
        }

        const moonX = 670 - camera.x * 0.1;
        const moonY = 110;
        circle(moonX, moonY, 54, 'rgba(220, 201, 255, 0.92)');
        circle(moonX, moonY, 62, 'rgba(255, 173, 242, 0.26)');
        ctx.fillStyle = 'rgba(255,255,255,0.12)';
        ctx.fillRect(moonX - 5, moonY - 5, 8, 8);

        const castleLayer = 0.25;
        for (let i = 0; i < 18; i++) {
          const x = i * 110 - (camera.x * castleLayer) % 110;
          const towerH = 110 + (i % 4) * 12;
          rect(x, WORLD.groundY - towerH, 38, towerH, '#150d20');
          rect(x + 12, WORLD.groundY - towerH + 12, 14, towerH - 20, '#2c1047');
          rect(x + 8, WORLD.groundY - towerH + 6, 4, 10, '#e351ff');
          rect(x + 26, WORLD.groundY - towerH + 10, 4, 10, '#87d5ff');
        }

        for (let i = 0; i < 24; i++) {
          const baseX = i * 80 - (camera.x * 0.45) % 80;
          rect(baseX, WORLD.groundY + 20, 30, 120, '#1b0d2a');
          rect(baseX + 6, WORLD.groundY + 52, 18, 12, '#3d1d62');
        }

        const farGlow = ctx.createLinearGradient(0, WORLD.groundY - 60, 0, canvas.height);
        farGlow.addColorStop(0, 'rgba(149, 101, 255, 0.0)');
        farGlow.addColorStop(1, 'rgba(108, 64, 156, 0.15)');
        ctx.fillStyle = farGlow;
        ctx.fillRect(0, WORLD.groundY - 60, canvas.width, canvas.height - (WORLD.groundY - 60));
      }

      function drawGround() {
        const baseY = WORLD.groundY;
        rect(0, baseY, canvas.width, canvas.height - baseY, '#170d2a');
        for (const tile of floorTiles) {
          const screenX = tile.x - camera.x;
          if (screenX < -40 || screenX > canvas.width + 40) continue;
          rect(screenX, baseY + 10, tile.w, tile.h, '#20142d');
          rect(screenX + 4, baseY + 16, tile.w - 8, 6, '#5c2f91');
          rect(screenX + 4, baseY + 28, tile.w - 8, 5, '#d25dff');
          rect(screenX + tile.w / 2 - 2, baseY + 32, 4, 58, '#6d48d7');
        }

        rect(0, baseY, canvas.width, 4, '#ff7be3');
      }

      function drawGoal() {
        const x = WORLD.goalX - camera.x;
        const gateY = WORLD.groundY - 110;
        rect(x, gateY, 22, 110, '#130d23');
        rect(x - 14, gateY + 10, 50, 8, '#b14cff');
        rect(x - 8, gateY + 18, 38, 80, '#301a49');
        rect(x + 7, gateY + 28, 8, 55, '#b9f0ff');
        circle(x + 11, gateY + 30, 10, 'rgba(161, 210, 255, 0.8)');
      }

      function drawPickup(item) {
        const x = item.x - camera.x;
        const y = item.y;
        circle(x + item.w / 2, y + item.h / 2, 9, '#8af0ff');
        circle(x + item.w / 2, y + item.h / 2, 5, '#fff1f0');
      }

      function drawPlayer() {
        const x = player.x - camera.x;
        const y = player.y;
        const blink = player.invuln > 0 && Math.floor(state.time * 18) % 2 === 0;
        if (blink) return;

        // hair + outline
        ctx.fillStyle = '#f4f4ff';
        ctx.fillRect(x + 8, y + 6, 18, 6);
        ctx.fillRect(x + 5, y + 10, 24, 8);
        ctx.fillRect(x + 2, y + 18, 30, 8);

        // head / face
        rect(x + 7, y + 12, 18, 18, '#f2dfe9');
        rect(x + 10, y + 16, 3, 3, '#ff8fc4');
        rect(x + 20, y + 16, 3, 3, '#ff8fc4');
        rect(x + 11, y + 21, 12, 3, '#b978bb');

        // hair strands
        rect(x + 4, y + 8, 4, 22, '#dfeafc');
        rect(x + 25, y + 8, 4, 22, '#dfeafc');
        rect(x + 12, y + 4, 3, 18, '#dfeafc');
        rect(x + 18, y + 4, 3, 18, '#dfeafc');

        // dress
        rect(x + 6, y + 30, 20, 16, '#20112c');
        rect(x + 9, y + 46, 6, 18, '#52406d');
        rect(x + 18, y + 46, 6, 18, '#52406d');
        rect(x + 5, y + 34, 24, 8, '#4b296d');

        // arm and sword
        rect(x + 17, y + 26, 6, 22, '#a777d6');
        rect(x + 10, y + 26, 6, 22, '#a777d6');

        if (player.attackTimer > 0) {
          const slashX = player.facing > 0 ? x + 28 : x - 24;
          ctx.strokeStyle = '#ff8cf3';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(slashX, y + 26);
          ctx.lineTo(slashX + player.facing * 24, y + 18);
          ctx.stroke();
        }

        // sword
        if (player.facing > 0) {
          rect(x + 23, y + 24, 28, 4, '#dcb7ff');
          rect(x + 50, y + 22, 6, 8, '#85d8ff');
        } else {
          rect(x - 26, y + 24, 28, 4, '#dcb7ff');
          rect(x - 38, y + 22, 6, 8, '#85d8ff');
        }

        // magic glow behind
        if (player.magicCooldown > 0) {
          circle(x + player.w / 2, y + 28, 18, 'rgba(155, 209, 255, 0.12)');
        }
      }

      function drawNoah() {
        const x = player.x - camera.x + 8;
        const y = player.y - 10 + Math.sin(state.time * 4) * 5;
        circle(x + player.w / 2, y, 8, '#dff9ff');
        circle(x + player.w / 2 - 2, y - 1, 2.2, '#7ed8ff');
        circle(x + player.w / 2 + 2, y - 1, 2.2, '#7ed8ff');
        ctx.strokeStyle = '#9ae6ff';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(x + player.w / 2, y + 4, 8, 0, Math.PI * 2);
        ctx.stroke();
      }

      function drawEnemy(enemy) {
        if (!enemy.alive) return;
        const x = enemy.x - camera.x;
        const y = enemy.y;

        ctx.fillStyle = enemy.type === 'boss' ? '#7f3ac6' : '#3b1c52';
        ctx.fillRect(x, y, enemy.w, enemy.h);
        ctx.fillStyle = enemy.type === 'boss' ? '#f4b7ff' : '#d184ff';
        ctx.fillRect(x + 4, y + 6, enemy.w - 8, 8);
        ctx.fillStyle = '#f4ecff';
        ctx.fillRect(x + 6, y + 16, 4, 4);
        ctx.fillRect(x + enemy.w - 10, y + 16, 4, 4);
        ctx.fillStyle = '#ff74c8';
        ctx.fillRect(x + 4, y + 25, enemy.w - 8, 5);

        if (enemy.type === 'boss') {
          circle(x + enemy.w / 2, y + 8, 14, 'rgba(255, 150, 244, 0.35)');
        }

        // hp bar
        const barW = enemy.w + 8;
        rect(x - 4, y - 10, barW, 6, 'rgba(20, 14, 28, 0.8)');
        const ratio = clamp(enemy.hp / enemy.maxHp, 0, 1);
        rect(x - 4, y - 10, barW * ratio, 6, enemy.type === 'boss' ? '#ff82d9' : '#7be6ff');
      }

      function drawProjectiles() {
        for (const shot of projectiles) {
          const x = shot.x - camera.x;
          circle(x, shot.y, shot.r, shot.color);
          circle(x, shot.y, shot.r + 4, 'rgba(175, 219, 255, 0.2)');
        }
      }

      function drawHUD() {
        const hpW = 130;
        rect(18, 18, hpW, 18, 'rgba(18, 12, 28, 0.9)');
        rect(18, 18, hpW * (player.hp / player.maxHp), 18, '#ff72d1');
        ctx.fillStyle = '#fff3ff';
        ctx.font = 'bold 11px sans-serif';
        ctx.fillText('HP ' + player.hp + '/' + player.maxHp, 24, 32);

        const scoreText = 'SCORE ' + state.score;
        ctx.fillStyle = '#f7e8ff';
        ctx.font = 'bold 12px sans-serif';
        ctx.fillText(scoreText, 170, 32);
      }

      function drawTitleOverlay() {
        const title = state.mode === 'title';
        const overlay = title || state.mode === 'over' || state.mode === 'win';
        if (!overlay) return;

        ctx.fillStyle = 'rgba(14, 8, 22, 0.38)';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const w = 360;
        const h = 170;
        const x = (canvas.width - w) / 2;
        const y = 150;
        ctx.fillStyle = 'rgba(28, 15, 35, 0.8)';
        ctx.fillRect(x, y, w, h);
        ctx.strokeStyle = '#e57dff';
        ctx.strokeRect(x, y, w, h);

        ctx.fillStyle = '#ffe6ff';
        ctx.font = 'bold 34px sans-serif';
        const label = state.mode === 'title' ? 'MIRAGE DROP' : state.mode === 'win' ? 'STAGE CLEAR' : 'GAME OVER';
        ctx.fillText(label, x + 60, y + 60);

        ctx.font = 'bold 16px sans-serif';
        ctx.fillStyle = '#d5c7f5';
        ctx.fillText(state.mode === 'title' ? 'ハクアとノアのネオン冒険' : 'SCORE ' + state.score, x + 110, y + 100);

        const startText = state.mode === 'title' ? '画面をタップして開始' : '画面をタップして再挑戦';
        ctx.fillText(startText, x + 78, y + 140);
      }

      function drawPausedOverlay() {
        if (state.mode === 'play' && state.paused) {
          ctx.fillStyle = 'rgba(12, 10, 18, 0.45)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = '#f8cdfd';
          ctx.font = 'bold 28px sans-serif';
          ctx.fillText('PAUSED', canvas.width / 2 - 72, canvas.height / 2);
        }
      }

      function draw() {
        drawBackground();
        drawGround();
        drawGoal();
        for (const pickup of pickups) drawPickup(pickup);
        drawProjectiles();
        for (const enemy of enemies) drawEnemy(enemy);
        drawNoah();
        drawPlayer();
        drawHUD();
        drawTitleOverlay();
        drawPausedOverlay();
      }

      function tick(timestamp) {
        const dt = lastTime ? Math.min((timestamp - lastTime) / 1000, 0.033) : 0.016;
        lastTime = timestamp;

        update(dt);
        draw();
        requestAnimationFrame(tick);
      }

      function bindKey(code, stateKey, pressed) {
        if (pressed) {
          input[stateKey] = true;
        } else if (stateKey === 'jump') {
          input.jump = false;
        } else if (stateKey === 'attack') {
          input.attack = false;
        } else if (stateKey === 'magic') {
          input.magic = false;
        } else {
          input[stateKey] = false;
        }
      }

      document.addEventListener('keydown', (event) => {
        const key = event.code;
        if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'Space', 'KeyA', 'KeyD', 'KeyJ', 'KeyK', 'KeyZ', 'KeyX', 'KeyP'].includes(key)) {
          event.preventDefault();
        }

        if (key === 'ArrowLeft' || key === 'KeyA') bindKey(key, 'left', true);
        if (key === 'ArrowRight' || key === 'KeyD') bindKey(key, 'right', true);
        if (key === 'ArrowUp' || key === 'Space') bindKey(key, 'jump', true);
        if (key === 'KeyJ' || key === 'KeyZ') bindKey(key, 'attack', true);
        if (key === 'KeyK' || key === 'KeyX') bindKey(key, 'magic', true);
        if (key === 'KeyP') setPaused(!state.paused);
      });

      document.addEventListener('keyup', (event) => {
        const key = event.code;
        if (key === 'ArrowLeft' || key === 'KeyA') input.left = false;
        if (key === 'ArrowRight' || key === 'KeyD') input.right = false;
        if (key === 'ArrowUp' || key === 'Space') input.jump = false;
        if (key === 'KeyJ' || key === 'KeyZ') input.attack = false;
        if (key === 'KeyK' || key === 'KeyX') input.magic = false;
      });

      document.addEventListener('pointerdown', () => {
        if (state.mode === 'title' || state.mode === 'over' || state.mode === 'win') {
          startGame();
        }
      });

      function setupButton(key, element) {
        element.addEventListener('pointerdown', (event) => {
          event.preventDefault();
          if (state.mode === 'title' || state.mode === 'over' || state.mode === 'win') {
            startGame();
          }
          input[key] = true;
          element.classList.add('active');
        });

        const release = (event) => {
          event.preventDefault();
          input[key] = false;
          element.classList.remove('active');
        };

        element.addEventListener('pointerup', release);
        element.addEventListener('pointerleave', release);
        element.addEventListener('pointercancel', release);
      }

      document.querySelectorAll('.ctrl').forEach((button) => {
        const key = button.dataset.key;
        setupButton(key, button);
      });

      pauseBtn.addEventListener('click', () => {
        if (state.mode !== 'play') {
          startGame();
          return;
        }
        setPaused(!state.paused);
      });

      makeStars();
      setState('title');
      resetGame();
      requestAnimationFrame(tick);
    })();
  </script>
</body>
</html>
